generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  logo          String
  orderCategory Int      @map("order_category")
  courses       Course[]
  themes        Theme[]

  @@map("category")
}

model Theme {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  img         String
  categoryId  Int      @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])
  courses     Course[]

  @@index([categoryId])
  @@map("theme")
}

enum Difficulty {
  debutant
  intermediaire
  confirme
}

enum ChapterType {
  cours
  exo
  tp
  quiz
}

model Course {
  id             Int         @id @default(autoincrement())
  title          String
  slug           String      @unique
  logo           String
  description    String      @db.Text
  date           DateTime    @db.Date
  duration       String
  categoryId     Int         @map("category_id")
  category       Category    @relation(fields: [categoryId], references: [id])
  difficulty     Difficulty?
  themeId        Int?        @map("theme_id")
  theme          Theme?      @relation(fields: [themeId], references: [id])
  available      Boolean
  price          String?
  oldPrice       String      @map("old_price")
  chapterCount   Int?        @map("chapter_count")
  author         String?
  supportUrl     String?     @map("support_url")
  supportName    String?     @map("support_name")
  chapters       Chapter[]
  programs       Program[]

  @@index([categoryId, available])
  @@index([themeId, available])
  @@map("course")
}

model Chapter {
  id          Int      @id @default(autoincrement())
  title       String
  duration    String
  urlVideo    String   @map("url_video")
  courseId    Int      @map("id_course_id")
  course      Course   @relation(fields: [courseId], references: [id])
  free        Boolean  @default(false)
  available   Boolean  @default(false)
  type        ChapterType?
  chapterPart String?  @map("chapter_part") @db.Text
  numOrder    Int      @map("num_order")
  description String?  @db.Text
  material    String?
  progress    VideoProgress[]

  @@index([courseId, available])
  @@map("chapter")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  roles    Json
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  phone     String?
  bio       String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  audioTipDismissed Boolean @default(false) @map("audio_tip_dismissed")
  progress  VideoProgress[]
  videoIdeas VideoIdea[]

  @@map("user")
}

model Contact {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact")
}


/// Position de lecture d'un membre dans la vidéo d'un chapitre (reprise + « vu / en cours »).
model VideoProgress {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  chapterId Int      @map("chapter_id")
  seconds   Int      @default(0)
  duration  Int      @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([chapterId])
  @@map("video_progress")
}

/// Traductions automatiques du contenu (cours, chapitres, catégories, thématiques).
/// Le français reste la source ; `sourceHash` = empreinte du texte français traduit (détecte les textes modifiés depuis).
model Translation {
  id         Int      @id @default(autoincrement())
  entity     String   // 'course' | 'chapter' | 'category' | 'theme'
  entityId   Int      @map("entity_id")
  field      String   // 'title' | 'description' | 'chapterPart'
  lang       String   // 'en'
  text       String   @db.Text
  sourceHash String   @map("source_hash")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([entity, entityId, field, lang])
  @@index([lang, entity])
  @@map("translation")
}

/// Idée de vidéo notée par un administrateur (espace personnel du back-office, jamais affichée sur le site).
model VideoIdea {
  id          Int             @id @default(autoincrement())
  userId      Int             @map("user_id")
  title       String
  description String          @default("") @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  links       VideoIdeaLink[]

  @@index([userId, updatedAt])
  @@map("video_idea")
}

/// Vidéo YouTube repérée comme source d'inspiration pour une idée.
model VideoIdeaLink {
  id       Int       @id @default(autoincrement())
  ideaId   Int       @map("idea_id")
  videoId  String    @map("video_id")
  url      String
  title    String?
  author   String?
  position Int       @default(0)
  idea     VideoIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("video_idea_link")
}

/// Programme de formation proposé aux clients B2B / centres de formation (catalogue public).
model Program {
  id              Int             @id @default(autoincrement())
  slug            String          @unique
  title           String
  tagline         String          @default("")
  summary         String          @default("") @db.Text
  domain          String          @default("web")        // web | data | design | marketing | systems | other
  level           String?                                // debutant | intermediaire | confirme
  coverImage      String          @default("") @map("cover_image")
  audience        String          @default("") @db.Text
  prerequisites   String          @default("") @db.Text
  objectives      String[]
  outcomes        String[]
  formats         String[]                               // presentiel | distanciel | mixte
  maxParticipants Int?            @map("max_participants")
  hoursPerDay     Int             @default(7) @map("hours_per_day")
  teachingMethods String          @default("") @db.Text @map("teaching_methods")
  evaluation      String          @default("") @db.Text
  equipment       String          @default("") @db.Text
  resources       String          @default("") @db.Text
  priceAmount     Int?            @map("price_amount")   // € HT
  priceUnit       String          @default("") @map("price_unit")
  showPrice       Boolean         @default(false) @map("show_price")
  status          String          @default("draft")      // draft | published
  position        Int             @default(0)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  modules         ProgramModule[]
  tools           Tool[]
  certifications  Certification[]
  courses         Course[]

  @@index([status, position])
  @@map("program")
}

model ProgramModule {
  id        Int               @id @default(autoincrement())
  programId Int               @map("program_id")
  position  Int               @default(0)
  group     String            @default("")   // regroupement affiché (ex. « Bloc 1 — Front-end », « Jour 1 »)
  title     String
  hours     Float             @default(0)
  content   String            @default("") @db.Text
  method    String            @default("")
  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  workshops ProgramWorkshop[]

  @@index([programId, position])
  @@map("program_module")
}

model ProgramWorkshop {
  id          Int           @id @default(autoincrement())
  moduleId    Int           @map("module_id")
  position    Int           @default(0)
  title       String
  hours       Float         @default(0)
  description String        @default("") @db.Text
  deliverable String        @default("")
  module      ProgramModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, position])
  @@map("program_workshop")
}

/// Bibliothèque d'outils réutilisables dans les programmes.
model Tool {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  logo     String    @default("")
  url      String    @default("")
  programs Program[]

  @@map("tool")
}

/// Bibliothèque de certifications (préparées ou délivrées) réutilisables dans les programmes.
model Certification {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  issuer      String    @default("")
  reference   String    @default("")   // ex. code RNCP
  level       String    @default("")
  description String    @default("") @db.Text
  url         String    @default("")
  logo        String    @default("")
  programs    Program[]

  @@map("certification")
}
